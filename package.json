{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier . --write",
    "check": "prettier . --check && oxlint --deny-warnings && stylelint --max-warnings 0 \"**/*.css\" && tsc -b && vite build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.4",
    "immer": "^11.1.21",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-icons": "^5.7.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-imagetools": "^10.0.1"
  },
  "lint-staged": {
    "*.{css,js,mjs,ts,tsx,json,yaml,yml,md}": "prettier --write",
    "*.{js,mjs,ts,tsx}": "oxlint --fix --no-error-on-unmatched-pattern"
  }
}
